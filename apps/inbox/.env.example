# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never prefix with NEXT_PUBLIC_ — it bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Twilio — console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx

# The public origin Twilio calls, exactly as it appears in the webhook URL.
# Signature validation hashes this string, so a mismatch fails every request.
PUBLIC_BASE_URL=https://inbox.larabeehomesllc.com

# Web push (VAPID). Generate once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@larabeehomesllc.com

# Shared secret between the Cloudflare email worker and /api/intake/email.
INTAKE_SECRET=

# Origin of your Squarespace site, for the website form endpoint's CORS.
WEBSITE_ORIGIN=https://www.larabeehomesllc.com
