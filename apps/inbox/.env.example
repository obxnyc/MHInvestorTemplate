# Supabase — Project Settings > API Keys
#
# That page offers two formats. Use the "Legacy anon, service_role API keys"
# tab: those are what this app was built and tested against.
#
# The newer sb_publishable_ / sb_secret_ keys also reach the client correctly --
# supabase-js passes any key straight through as both the apikey header and the
# bearer token, verified against the installed version -- but whether sb_secret_
# carries the same RLS-bypassing privilege as service_role is decided on
# Supabase's side, not here. If it does not, the Twilio webhooks fail to write
# and the error does not say why. Worth confirming on a running deployment
# before switching; it is an env change, not a code change.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never prefix with NEXT_PUBLIC_ — it bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Twilio — console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx

# The public origin, used for the links and callback URLs the app hands out.
# Webhook signature checking no longer depends on it -- the URL is rebuilt from
# the host the request arrived on, so a wrong or missing value here can no
# longer silently 403 every inbound text. Set it anyway: it decides which host
# appears in the booking links texted to applicants.
PUBLIC_BASE_URL=https://inbox.larabeehomesllc.com

# Web push (VAPID). Generate once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@larabeehomesllc.com

# Shared secret between the Cloudflare email worker and /api/intake/email.
INTAKE_SECRET=

# Origin of your Squarespace site, for the website form endpoint's CORS.
WEBSITE_ORIGIN=https://www.larabeehomesllc.com

# Cal.com booking (Phase 2b showings)
CALCOM_EVENT_URL=https://cal.com/larabee/showing
CALCOM_WEBHOOK_SECRET=

# Optional outbound email (decline explanations read better than an SMS)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=leasing@larabeehomesllc.com

# Classifier. Without this the deterministic layers still run (source,
# emergency keywords, sender identity); only genuinely ambiguous messages
# lose their model pass and fall to the review queue.
ANTHROPIC_API_KEY=

# Daily housekeeping job (Vercel Cron sends this as a bearer token).
CRON_SECRET=
AUTOCLOSE_DAYS=30
RECYCLE_QUIET_DAYS=7
RECYCLE_REPEAT_DAYS=7
